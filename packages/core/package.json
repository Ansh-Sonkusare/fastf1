{
  "name": "@teakmirror113/f1-core",
  "version": "0.1.0",
  "description": "TypeScript client for Formula 1 data from OpenF1: laps, stints, pit stops, telemetry and race control.",
  "keywords": ["formula1", "f1", "openf1", "telemetry", "motorsport", "effect"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansh-Sonkusare/fastf1.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Ansh-Sonkusare/fastf1/issues"
  },
  "homepage": "https://github.com/Ansh-Sonkusare/fastf1/tree/main/packages/core#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "vite build"
  },
  "dependencies": {
    "quick-lru": "^6.1.2",
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite-plugin-dts": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
